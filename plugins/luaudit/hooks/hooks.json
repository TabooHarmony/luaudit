{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|PowerShell|shell_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/luaudit-hook\"",
            "command_windows": "${CLAUDE_PLUGIN_ROOT}\\scripts\\luaudit-hook.cmd",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/luaudit-hook\" stop-hook",
            "command_windows": "${CLAUDE_PLUGIN_ROOT}\\scripts\\luaudit-hook.cmd stop-hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
